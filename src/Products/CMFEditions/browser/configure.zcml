<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <!-- Note: the "history", "get_macros", "version_file_view",
       "version_image_view", "version_metadata_view", "diff_legend",
       "versions_history_form" and "compare.css" views have moved to
       plone.app.layout, since they are Classic UI only. -->

  <browser:page
      name="update_version_on_edit"
      for="*"
      class=".views.UpdateVersionOnEditView"
      permission="zope2.View"
      />

  <browser:page
      name="update_version_before_edit"
      for="*"
      class=".views.UpdateVersionBeforeEditView"
      permission="zope2.View"
      />

  <browser:page
      name="saveasnewversion"
      for="*"
      class=".policies.SaveAsNewVersion"
      permission="zope2.View"
      />

  <browser:page
      name="revertversion"
      for="*"
      class=".policies.RevertVersion"
      permission="zope2.View"
      />

</configure>
