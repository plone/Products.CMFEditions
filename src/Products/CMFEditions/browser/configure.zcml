<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <!-- Note: "history" and "versions_history_form" have no template here:
       they hold the API-level logic only, so they stay available to API
       consumers (plone.restapi, plone.api) without plone.app.layout
       installed. plone.app.layout registers overrides on
       IPloneAppLayoutLayer that render the actual Classic UI HTML.
       "version_file_view", "version_image_view", "version_metadata_view",
       "diff_legend" and "compare.css" are pure Classic UI rendering
       fragments and have moved to plone.app.layout entirely. -->

  <browser:page
      name="history"
      for="*"
      class=".diff.DiffView"
      permission="CMFEditions.AccessPreviousVersions"
      />

  <browser:page
      name="get_macros"
      for="*"
      class=".utils.GetMacros"
      attribute="get_macros"
      permission="zope2.View"
      />

  <browser:page
      name="update_version_on_edit"
      for="*"
      class=".views.UpdateVersionOnEditView"
      permission="zope2.View"
      />

  <browser:page
      name="update_version_before_edit"
      for="*"
      class=".views.UpdateVersionBeforeEditView"
      permission="zope2.View"
      />

  <browser:page
      name="saveasnewversion"
      for="*"
      class=".policies.SaveAsNewVersion"
      permission="zope2.View"
      />

  <browser:page
      name="revertversion"
      for="*"
      class=".policies.RevertVersion"
      permission="zope2.View"
      />

  <browser:page
      name="versions_history_form"
      for="*"
      class=".views.VersionsHistoryForm"
      permission="zope2.View"
      />

</configure>
